APP_NAME="Reganto IT Solution"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public address of the site. Used for the sitemap, canonical links and share images.
# Set it to the real domain when you go live, e.g. https://regantoitsolution.com
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# XAMPP MySQL defaults. Create the database first (phpMyAdmin or: CREATE DATABASE regantoitsolution).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=regantoitsolution
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

# First admin account, created by `php artisan db:seed`.
# Choose your own values BEFORE seeding. Never keep the defaults on a live site.
ADMIN_EMAIL=admin@regantoitsolution.com
ADMIN_PASSWORD=
